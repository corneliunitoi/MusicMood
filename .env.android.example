# Copied to .env.android by `npm run android:setup` (or copy it yourself). See ANDROID_BUILD.md.
# The server the app calls for track lookups (no trailing slash).
VITE_API_BASE_URL=https://musicmood.co.uk
# Native Google sign-in: the *Web* OAuth client ID from Google Cloud (the one Supabase uses),
# ending in .apps.googleusercontent.com. NOT the Android client ID. It is public, not a secret.
VITE_GOOGLE_WEB_CLIENT_ID=
